# Hostinger / Apache configuration for Ayyanar Construction CRM
# SPA routing and PWA caching rules

Options -MultiViews
Options -Indexes
RewriteEngine On

# ----------------------------------------------------------------------
# 1. SPA ROUTING: Route all non-file/directory requests to index.html
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ----------------------------------------------------------------------
# 2. HTTP CACHING & PWA UPDATE HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Content-hashed fonts and styles
  <FilesMatch "\.(css|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Content-hashed JavaScript bundles
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Standard unhashed images, favicons, app icons (1 day with revalidation)
  <FilesMatch "\.(png|jpg|jpeg|gif|ico|svg|webp)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  # ----------------------------------------------------------------------
  # CRITICAL OVERRIDES: sw.js, index.html, version.json, and manifests
  # These files MUST NEVER be cached long-term by browsers, proxies, or CDNs.
  # This guarantees immediate detection of new deployments.
  # ----------------------------------------------------------------------
  <FilesMatch "(^sw\.js$|^service-worker\.js$|^index\.html$|^version\.json$|^manifest\.json$|\.webmanifest$)">
    Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Explicit override specifically for Service Worker script
  <Files "sw.js">
    Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set Service-Worker-Allowed "/"
  </Files>

  # Explicit override specifically for version metadata check
  <Files "version.json">
    Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  # Explicit override specifically for HTML entry point
  <Files "index.html">
    Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  # Explicit override specifically for Web App Manifest
  <Files "manifest.json">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>
</IfModule>
