# Copy this file to `.env` for local development, or set these
# as Environment Variables in Hostinger hPanel for production.

# --- MySQL Database (from hPanel -> Databases -> MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=construction_erp

# --- Server ---
# Hostinger sets PORT automatically; only set this for local development
# PORT=5000

# --- Uploaded photos & bills (attendance selfies, site photos, driver bills) ---
# CRITICAL: without this, uploads live inside the app's own deploy folder and
# are DELETED every time you push a code update. Point this at a folder
# OUTSIDE your app's deployment directory that Hostinger does not touch on
# redeploy (e.g. a sibling "storage" folder in your hosting account's home
# directory), then set it as an Environment Variable in hPanel.
# UPLOADS_ROOT_DIR=/home/<hostinger-user>/persistent-uploads
